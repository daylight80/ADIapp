# Copy to backend/.env and fill in real values. Never commit the real .env.

# "development" enables demo account seeding. Anything else (or unset)
# is treated as production and skips it — must be "production" on any
# real deployment.
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to call this API with
# credentials. Required in production — CORS is closed if left empty.
# e.g. CORS_ORIGINS=https://app.drivehubuk.com,https://drivehubuk.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=drivehub

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# --- Stripe ---
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FRANCHISE_BASE=
STRIPE_PRICE_FRANCHISE_SEAT=

APP_DOMAIN=http://localhost:3000

# --- Optional integrations ---
GOOGLE_MAPS_API_KEY=
EMERGENT_LLM_KEY=

# --- Supabase (used by webhook + Supabase-auth-bridge endpoints) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
