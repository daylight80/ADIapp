{
  "expo": {
    "name": "DualControl",
    "slug": "adi-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adipro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan fuel and maintenance receipts",
        "NSPhotoLibraryUsageDescription": "Attach receipt photos to expenses",
        "NSContactsUsageDescription": "Import student names and phone numbers",
        "NSLocationWhenInUseUsageDescription": "Record driving lesson routes via GPS",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track routes when the phone is locked",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "bundleIdentifier": "uk.co.drivingschoolsolutions.adi"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#0A2147"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_CONTACTS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "uk.co.drivingschoolsolutions.adi",
      "googleServicesFile": "./google-services.json"
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00539F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Record driving lesson routes via GPS",
          "locationAlwaysAndWhenInUsePermission": "Track lessons when the phone is locked",
          "locationAlwaysPermission": "Track lessons when the phone is locked",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "grant-robery",
          "project": "adi-pro"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2deb51d-29d1-4811-a546-614c703f3e39"
      }
    }
  }
}
